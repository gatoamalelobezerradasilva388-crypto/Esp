local function toggle(parent, label, config, key)
    local button

    local function update()
        button.Text = label .. ": " ..
            (config[key] and "ON" or "OFF")

        button.BackgroundColor3 =
            config[key] and Theme.Accent or Theme.Background
    end

    button = createButton(parent, "", function()
        config[key] = not config[key]
        update()
    end)

    update()
end

