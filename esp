-- AIM TRAINER
-- Só considera modelos dentro de Workspace.NEXUSTargets.

local function findTrainingTarget()
    local folder = workspace:FindFirstChild("NEXUSTargets")
    if not folder then return nil end

    local center = Vector2.new(
        Camera.ViewportSize.X / 2,
        Camera.ViewportSize.Y / 2
    )

    local bestTarget = nil
    local bestDistance = Aim.FOV

    for _, model in ipairs(folder:GetChildren()) do
        if model:GetAttribute("IsNexusTarget") then
            local head = model:FindFirstChild("Head")
            local humanoid = model:FindFirstChildOfClass("Humanoid")

            if head and humanoid and humanoid.Health > 0 then
                local point, visible =
                    Camera:WorldToViewportPoint(head.Position)

                if visible then
                    local screenPosition = Vector2.new(
                        point.X, point.Y
                    )

                    local distance =
                        (screenPosition - center).Magnitude

                    if distance < bestDistance then
                        bestDistance = distance
                        bestTarget = head
                    end
                end
            end
        end
    end

    return bestTarget
end

-- LOOP PRINCIPAL

RunService.RenderStepped:Connect(function()
    Camera = workspace.CurrentCamera

    local folder = workspace:FindFirstChild("NEXUSTargets")

    if folder then
        for _, model in ipairs(folder:GetChildren()) do
            if model:IsA("Model")
            and model:GetAttribute("IsNexusTarget") then

                if not ESPObjects[model] then
                    ESPObjects[model] = makeESPObject(model)
                end

                updateESP(model, ESPObjects[model])
            end
        end
    end

    for model, data in pairs(ESPObjects) do
        if not model.Parent then
            data.Container:Destroy()
            data.Highlight:Destroy()
            ESPObjects[model] = nil
        end
    end

    FOVCircle.Visible = Aim.Enabled
    FOVCircle.Size = UDim2.fromOffset(
        Aim.FOV * 2,
        Aim.FOV * 2
    )

    if Aim.Enabled then
        local target = findTrainingTarget()

        if target then
            local goal = CFrame.lookAt(
                Camera.CFrame.Position,
                target.Position
            )

            Camera.CFrame = Camera.CFrame:Lerp(
                goal,
                Aim.Smoothness
            )
        end
    end
end)

