local function getCorners(model)
    local cf, size = model:GetBoundingBox()
    local corners = {}

    for x = -1, 1, 2 do
        for y = -1, 1, 2 do
            for z = -1, 1, 2 do
                table.insert(corners,
                    cf:PointToWorldSpace(Vector3.new(
                        size.X * x / 2,
                        size.Y * y / 2,
                        size.Z * z / 2
                    ))
                )
            end
        end
    end

    return corners
end

local function updateESP(model, data)
    local root = model:FindFirstChild("HumanoidRootPart")
    local humanoid = model:FindFirstChildOfClass("Humanoid")

    if not root or not humanoid then
        data.Container.Visible = false
        return
    end

    local distance = (Camera.CFrame.Position - root.Position).Magnitude

    if not ESP.Enabled or distance > ESP.MaxDistance then
        data.Container.Visible = false
        data.Highlight.Enabled = false
        return
    end

    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local visible = false

    for _, corner in ipairs(getCorners(model)) do
        local point, onScreen = Camera:WorldToViewportPoint(corner)

        if onScreen then
            visible = true
        end

        if point.Z > 0 then
            minX = math.min(minX, point.X)
            minY = math.min(minY, point.Y)
            maxX = math.max(maxX, point.X)
            maxY = math.max(maxY, point.Y)
        end
    end

    if not visible or minX == math.huge then
        data.Container.Visible = false
        data.Highlight.Enabled = false
        return
    end

    data.Container.Visible = true
    data.Highlight.Enabled = ESP.Chams

    local width = math.max(maxX - minX, 2)
    local height = math.max(maxY - minY, 2)

    data.Box.Visible = ESP.Box
    data.Box.Position = UDim2.fromOffset(minX, minY)
    data.Box.Size = UDim2.fromOffset(width, height)

    local center = Vector2.new(
        Camera.ViewportSize.X / 2,
        Camera.ViewportSize.Y / 2
    )

    local targetCenter = Vector2.new(
        (minX + maxX) / 2,
        (minY + maxY) / 2
    )

    local delta = targetCenter - center
    local length = delta.Magnitude

    data.Line.Visible = ESP.Lines
    data.Line.Position = UDim2.fromOffset(center.X, center.Y)
    data.Line.Size = UDim2.fromOffset(length, 1.5)
    data.Line.Rotation = math.deg(
        math.atan2(delta.Y, delta.X)
    )

    data.Name.Visible = ESP.Names
    data.Name.Text = model.Name
    data.Name.Size = UDim2.fromOffset(width + 50, 18)
    data.Name.Position = UDim2.fromOffset(minX - 25, minY - 20)

    data.Distance.Visible = ESP.Distance
    data.Distance.Text = string.format("%.0f studs", distance)
    data.Distance.Size = UDim2.fromOffset(width + 50, 16)
    data.Distance.Position = UDim2.fromOffset(minX - 25, maxY + 2)

    data.HealthBG.Visible = ESP.Health
    data.HealthBG.Position = UDim2.fromOffset(minX - 6, minY)
    data.HealthBG.Size = UDim2.fromOffset(4, height)

    local healthPercent = math.clamp(
        humanoid.Health / math.max(humanoid.MaxHealth, 1),
        0, 1
    )

    data.HealthFill.Size = UDim2.new(1, 0, healthPercent, 0)
    data.HealthFill.Position = UDim2.new(0, 0, 1 - healthPercent, 0)
end

